  "part_a": [
    {
      "text": "Přestup na stejném nástupišti – 2 minuty",
      "source_row": 6,
      "structured": {
        "type": "transfer_time",
        "minutes": 2,
        "applies_to": "Přestup na stejném nástupišti"
      }
    },
    {
      "text": "Přestup na sousední nástupiště – 3 minuty a na každé další nástupiště o jednu minutu více, max. 4 minuty",
      "source_row": 7,
      "structured": {
        "type": "rule_set",
        "source": "manual",
        "rules": [
          {
            "type": "info",
            "note": "Přestupní doba podle vzdálenosti nástupišť (3–4 min) – nástupiště zatím nevyhodnocujeme."
          }
        ]
      }
    }
  ],
  "part_b": [
    {
      "text": "Mezi vlaky není přípoj, je-li mezi příjezdem a odjezdem vlaků interval kratší než 4 minuty.",
      "source_row": 10,
      "structured": {
        "type": "min_interval",
        "minutes": 4,
        "meaning": "Je-li plánovaný interval mezi příjezdem přípojného a odjezdem návazného vlaku kratší, nejde o přípoj."
      }
    },
    {
      "text": "Jinak platí základní pravidla dle článku 2.",
      "source_row": 11,
      "structured": {
        "type": "default_rules"
      }
    }
  ],
