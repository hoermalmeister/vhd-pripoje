  "part_b": [
    {
      "text": "Vlaky ČD jsou přípojem od vlaků dopravce RJ pouze linky R8 Brno hl.n. – Bohumín (zahrnuty i pod \"V\"), nejsou přípojem vlaků ostatních dopravců pokud není v části C stanoveno jinak.",
      "source_row": 11,
      "structured": {
        "type": "operator_connection",
        "waiting_operators": [
          "ČD"
        ],
        "connecting_operators": [
          "RJ"
        ],
        "reciprocal": false,
        "exclusive": true,
        "connecting_lines": [
          "R8"
        ],
        "note": "Omezení na linku se vztahuje k dopravci RJ uvedenému v textu."
      }
    },
    {
      "text": "Vlaky RJ linky R8 Brno – Bohumín jsou přípojem vlaků dopravce ČD.",
