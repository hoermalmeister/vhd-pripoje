      "text": "Přestup na stejném nástupišti – 3 minuty",
      "source_row": 6,
      "structured": {
        "type": "transfer_time",
        "minutes": 3,
        "applies_to": "Přestup na stejném nástupišti"
      }
    },
    {
      "text": "Přestup na sousední nástupiště – 4 minuty a na každé další nástupiště o jednu minutu více",
      "source_row": 7,
      "structured": {
        "type": "transfer_time",
        "minutes": 4,
        "applies_to": "Přestup na sousední nástupiště – 4 minuty a na každé další nástupiště o jednu minutu více"
      }
    },
    {
      "text": "Přestup z 1A nástupiště na 1. nástupiště – 3 minuty a na každé další nástupiště o jednu minutu více",
      "source_row": 8,
      "structured": {
        "type": "transfer_time",
        "minutes": 3,
        "applies_to": "Přestup z 1A nástupiště na 1. nástupiště – 3 minuty a na každé další nástupiště o jednu minutu více"
      }
    }
  ],
  "part_b": [
    {
      "text": "Mezi vlaky není přípoj, je-li mezi příjezdem a odjezdem vlaků interval kratší než 4 minuty.",
      "source_row": 11,
      "structured": {
        "type": "min_interval",
        "minutes": 4,
        "meaning": "Je-li plánovaný interval mezi příjezdem přípojného a odjezdem návazného vlaku kratší, nejde o přípoj."
      }
    },
    {
      "text": "Vlaky ČD jsou přípojem od vlaků dopravce ARR a naopak, nejsou přípojem vlaků ostatních dopravců.",
      "source_row": 12,
      "structured": {
        "type": "operator_connection",
        "waiting_operators": [
          "ČD"
        ],
        "connecting_operators": [
          "ARR"
        ],
        "reciprocal": true,
        "exclusive": true
      }
    },
    {
      "text": "Jinak platí základní pravidla dle článku 2.",
      "source_row": 13,
      "structured": {
        "type": "default_rules"
      }
    }
  ],
