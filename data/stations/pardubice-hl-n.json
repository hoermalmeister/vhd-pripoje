  },
  "part_a": [
    {
      "text": "Přestup na stejném nástupišti – 2 minuty",
      "source_row": 6,
      "structured": {
        "type": "transfer_time",
        "minutes": 2,
        "applies_to": "Přestup na stejném nástupišti"
      }
    },
    {
      "text": "Přestup na sousední nástupiště – 4 minuty; na/z nástupiště 1A (kromě na/z nástupiště 5) – 5 minut",
      "source_row": 7,
      "structured": {
        "type": "rule_set",
        "source": "manual",
        "rules": [
          {
            "type": "info",
            "note": "Přestupní doby podle nástupišť (4–5 min) – nástupiště zatím nevyhodnocujeme."
          }
        ]
      }
    },
    {
      "text": "Přestup mezi nástupišti 1 a 1A – 3 minuty",
      "source_row": 8,
      "structured": {
        "type": "transfer_time",
        "minutes": 3,
        "applies_to": "Přestup mezi nástupišti 1 a 1A"
      }
    },
    {
      "text": "Přestup mezi nástupišti 5 a 2 – 5 minut, mezi nástupišti 5 a 1, 1A – 6 minut",
      "source_row": 9,
      "structured": {
        "type": "rule_set",
        "source": "manual",
        "rules": [
          {
            "type": "info",
            "note": "Přestupní doby mezi nástupišti 5 a 1/1A/2 (5–6 min) – nástupiště zatím nevyhodnocujeme."
          }
        ]
      }
    }
  ],
  "part_b": [
    {
      "text": "Mezi vlaky není přípoj, je-li mezi příjezdem a odjezdem vlaků interval kratší než 4 minuty.",
      "source_row": 12,
      "structured": {
        "type": "min_interval",
        "minutes": 4,
        "meaning": "Je-li plánovaný interval mezi příjezdem přípojného a odjezdem návazného vlaku kratší, nejde o přípoj."
      }
    },
    {
      "text": "Vlaky ČD jsou přípojem vlaků dopravců ARR a LET, nejsou přípojem vlaků ostatních dopravců.",
      "source_row": 13,
      "structured": {
        "type": "operator_connection",
        "waiting_operators": [
          "ČD"
        ],
        "connecting_operators": [
          "ARR",
          "LET"
        ],
        "reciprocal": false,
        "exclusive": true
      }
    },
    {
      "text": "Vlaky ve směru jízdy na zastávku Pardubice centrum nečekají na žádné přípoje.",
      "source_row": 14,
      "structured": {
        "type": "rule_set",
        "source": "manual",
        "rules": [
          {
            "type": "connection_rule",
            "effect": "no_connection",
            "waiting": {
              "all": true,
              "to_directions": [
                "Pardubice centrum"
              ]
            },
            "connecting": {
              "all": true
            },
            "note": "Vlaky ve směru zastávky Pardubice centrum nečekají na žádné přípoje."
          }
        ]
      }
    },
    {
      "text": "Jinak platí základní pravidla dle článku 2.",
      "source_row": 15,
      "structured": {
        "type": "default_rules"
      }
    }
  ],
