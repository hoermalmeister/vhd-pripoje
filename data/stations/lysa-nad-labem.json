  "part_b": [
    {
      "text": "Vlaky ČD jsou přípojem od vlaků dopravce RJ (linky R23), nejsou přípojem vlaků ostatních dopravců.",
      "structured": {
        "type": "operator_connection",
        "waiting_operators": [
          "ČD"
        ],
        "connecting_operators": [
          "RJ"
        ],
        "reciprocal": false,
        "exclusive": true,
        "connecting_lines": [
          "R23"
        ],
        "note": "Omezení na linku se vztahuje k dopravci RJ uvedenému v textu."
      }
    },
    {
      "text": "Mezi vlaky není přípoj, pokud je mezi příjezdem a odjezdem interval kratší než 4 minuty.",
      "structured": {
        "type": "min_interval",
        "minutes": 4,
        "meaning": "Je-li plánovaný interval mezi příjezdem přípojného a odjezdem návazného vlaku kratší, nejde o přípoj."
      }
    },
    {
      "text": "Jinak platí základní pravidla dle článku 2.",
      "structured": {
        "type": "default_rules"
      }
    }
  ],
