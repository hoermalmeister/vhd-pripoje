      "structured": {
        "type": "transfer_time",
        "minutes": 2,
        "applies_to": "Přestup na stejném nástupišti"
      }
    },
    {
      "text": "Přestup na sousední nástupiště – 3 minuty, a na každé další nástupiště o jednu minutu více, max. 4 minuty",
      "structured": {
        "type": "text",
        "parse": "none"
      }
    }
  ],
  "part_b": [
    {
      "text": "Mezi vlaky není přípoj, je-li mezi příjezdem a odjezdem vlaků interval kratší než 3 minuty.",
      "structured": {
        "type": "min_interval",
        "minutes": 3,
        "meaning": "Je-li plánovaný interval mezi příjezdem přípojného a odjezdem návazného vlaku kratší, nejde o přípoj."
      }
    },
    {
      "text": "Vlaky ČD jsou přípojem od vlaků dopravce RJ pouze linky R8 Brno hl.n. – Bohumín, nejsou přípojem vlaků ostatních dopravců.",
      "structured": {
        "type": "text",
        "parse": "none"
      }
    },
    {
      "text": "Vlaky linky R8 směr Brno a Bohumín jsou přípojem od ostatních spojů ČD.",
      "structured": {
        "type": "text",
        "parse": "none"
      }
    },
    {
      "text": "Jinak platí základní pravidla dle článku 2.",
      "structured": {
        "type": "default_rules"
      }
    }
  ],
