  "part_b": [
    {
      "text": "Mezi vlaky není přípoj, pokud je mezi příjezdem a odjezdem interval kratší než 7 minut.",
      "structured": {
        "type": "min_interval",
        "minutes": 7,
        "meaning": "Je-li plánovaný interval mezi příjezdem přípojného a odjezdem návazného vlaku kratší, nejde o přípoj."
      }
    },
    {
      "text": "Vlaky ČD jsou přípojem od vlaků dopravce KŽC a ARR od Berouna a Všetat, nejsou přípojem vlaků ostatních dopravců (ARR z ostatních směrů).",
      "structured": {
        "type": "text",
        "parse": "none"
      }
    },
    {
      "text": "Vlaky dálkové dopravy ze směru Kolín nejsou přípojem na vlaky dálkové dopravy směr Nymburk a opačně.",
      "structured": {
        "type": "text",
        "parse": "none"
      }
    },
    {
      "text": "Jinak platí základní pravidla dle článku 2.",
      "structured": {
        "type": "default_rules"
      }
    }
  ],
