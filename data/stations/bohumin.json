  "part_a": [
    {
      "text": "Základní přestupní doba je 3 minuty.",
      "structured": {
        "type": "transfer_time",
        "minutes": 3,
        "applies_to": "základní přestupní doba ve stanici"
      }
    },
    {
      "text": "Přestup na stejném nástupišti (hrana – hrana) – 2 minuty",
      "structured": {
        "type": "transfer_time",
        "minutes": 2,
        "applies_to": "Přestup na stejném nástupišti (hrana – hrana)"
      }
    },
    {
      "text": "Přestup z 1. nástupiště na nástupiště 1A – 2 minuty",
      "structured": {
        "type": "transfer_time",
        "minutes": 2,
        "applies_to": "Přestup z 1. nástupiště na nástupiště 1A"
      }
    },
    {
      "text": "Přestup z 1. nástupiště na nástupiště 2–4 jsou 4 minuty, z nástupiště 1A na nástupiště 2–4 – 5 minut",
      "structured": {
        "type": "text",
        "parse": "none"
      }
    }
  ],
  "part_b": [
    {
      "text": "Všechny vlaky Ex a R ve směru Zebrzydowice jsou přípojnými pro vlaky ze směru Český Těšín, pokud jsou uvedeny v části C.",
      "structured": {
        "type": "text",
        "parse": "none"
      }
    },
    {
      "text": "Ve stanici není zaručen přestup mezi vlaky, je-li mezi příjezdem a odjezdem přípojných vlaků interval menší než 3 minuty, pokud není v části A nebo B stanoveno jinak.",
      "structured": {
        "type": "min_interval",
        "minutes": 3,
        "meaning": "Je-li plánovaný interval mezi příjezdem přípojného a odjezdem návazného vlaku kratší, nejde o přípoj."
      }
    },
    {
      "text": "Vlaky ČD jsou přípojem od vlaků dopravce RJ pouze linky R8 Brno hl.n. – Bohumín (zahrnuty i pod \"V\"), nejsou přípojem vlaků ostatních dopravců pokud není v části C stanoveno jinak.",
      "structured": {
        "type": "text",
        "parse": "none"
      }
    },
    {
      "text": "Vlaky RJ pouze linky R8 Brno – Bohumín jsou přípojem vlaků dopravce ČD, nejsou přípojem vlaků ostatních dopravců.",
      "structured": {
        "type": "text",
        "parse": "none"
      }
    },
    {
      "text": "Jinak platí základní pravidla dle článku 2.",
      "structured": {
        "type": "default_rules"
      }
    }
  ],
